{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true
  },
  "include": [
    "src/renderer/**/*",
    "src/editor/**/*",
    "src/shared/**/*",
    "tests/renderer/**/*",
    "tests/editor/**/*",
    "tests/setup-renderer.ts"
  ]
}
