{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "tests/core/**/*",
    "tests/ai/**/*",
    "tests/main/**/*",
    "tests/architecture/**/*",
    "tests/helpers/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
